template<A, B, CarrierC set, f fn(x A) B, g fn(y B) CarrierC>:
    have fn composition(x A) CarrierC = g(f(x))

template<X, Y set, f fn(x X) Y, K power_set(X)>:
    have fn restricted(x K) Y = f(x)

thm restriction_type:
    ? forall X, Y set, f fn(x X) Y, K power_set(X):
        \restricted<X,Y,f,K> $in fn(x K) Y
    release thm fn_set_member(\restricted<X,Y,f,K>, fn(x K) Y)
