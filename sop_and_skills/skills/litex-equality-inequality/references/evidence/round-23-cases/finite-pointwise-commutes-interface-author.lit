thm scalar_commutative_probe22:
    ? forall lhs,rhs R:
        lhs*rhs=rhs*lhs

claim:
    ? forall n N+,u,v fn(t closed_range(1,n)) R,a R,idx closed_range(1,n):
        fn(k closed_range(1,n)) R {u(k)+v(k)}(idx)*a=a*fn(k closed_range(1,n)) R {u(k)+v(k)}(idx)
    by thm scalar_commutative_probe22(fn(k closed_range(1,n)) R {u(k)+v(k)}(idx),a) => fn(k closed_range(1,n)) R {u(k)+v(k)}(idx)*a=a*fn(k closed_range(1,n)) R {u(k)+v(k)}(idx)
