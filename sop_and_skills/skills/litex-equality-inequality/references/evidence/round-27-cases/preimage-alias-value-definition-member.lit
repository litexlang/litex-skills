template<X, Y set, f fn(x X) Y, U power_set(Y)>:
    have inverse_image power_set(X) = {x X: f(x) $in U}

claim:
    ? forall X,Y set,f fn(x X) Y,U power_set(Y),E power_set(X),p E:
        E=\inverse_image<X,Y,f,U>
        =>:
            f(p) $in U
    E=\inverse_image<X,Y,f,U> = {x X: f(x) $in U}
    p $in E
