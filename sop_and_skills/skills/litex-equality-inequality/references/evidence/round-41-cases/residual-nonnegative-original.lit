have fn r41_square_root_two_residual(x R) R = x^2 - 2
claim:
    ? forall x R+:
        (x + 2 / x) / 2 $in R+
    x > 0
    x != 0
    2 / x > 0
    x + 2 / x > 0
    (x + 2 / x) / 2 > 0

have fn r41_newton_sqrt_two(x R+) R+ = (x + 2 / x) / 2

thm r41_newton_sqrt_two_residual_identity:
    ? forall x R+:
        4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x)) = r41_square_root_two_residual(x)^2
    x > 0
    x != 0
    have next_value R+ = r41_newton_sqrt_two(x)
    r41_square_root_two_residual(next_value) = next_value^2 - 2
    r41_square_root_two_residual(r41_newton_sqrt_two(x)) = r41_square_root_two_residual(next_value) = next_value^2 - 2 = r41_newton_sqrt_two(x)^2 - 2
    r41_square_root_two_residual(x) = x^2 - 2
    r41_newton_sqrt_two(x) = (x + 2 / x) / 2
    r41_newton_sqrt_two(x)^2 - 2 = ((x + 2 / x) / 2)^2 - 2
    r41_square_root_two_residual(r41_newton_sqrt_two(x)) = r41_newton_sqrt_two(x)^2 - 2 = ((x + 2 / x) / 2)^2 - 2
    r41_square_root_two_residual(x)^2 = (x^2 - 2)^2
    4 * x^2 * (((x + 2 / x) / 2)^2 - 2) = (x^2 - 2)^2
    4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x)) = 4 * x^2 * (((x + 2 / x) / 2)^2 - 2) = (x^2 - 2)^2 = r41_square_root_two_residual(x)^2

thm r41_residual_nonnegative_original:
    ? forall x R+:
        r41_square_root_two_residual(r41_newton_sqrt_two(x)) >= 0
    release thm r41_newton_sqrt_two_residual_identity(x)
    4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x)) = r41_square_root_two_residual(x)^2
    x^2 > 0
    4 * x^2 > 0
    4 * x^2 != 0
    r41_square_root_two_residual(x)^2 >= 0
    4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x)) >= 0
    r41_square_root_two_residual(r41_newton_sqrt_two(x)) $in R
    x^2 $in R
    4 * x^2 $in R
    4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x)) $in R
    (4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x))) / (4 * x^2) $in R
    (4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x))) / (4 * x^2) >= 0
    r41_square_root_two_residual(r41_newton_sqrt_two(x)) = (4 * x^2 * r41_square_root_two_residual(r41_newton_sqrt_two(x))) / (4 * x^2) >= 0

# Step 1: start with an arbitrary positive x and calculate one update.
# The new residual is nonnegative, so the exact algebraic identity also gives
# an exact identity for the absolute residual gap.
