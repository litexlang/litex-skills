prop GroupSetting(A nonempty_set, mul fn(x, y A) A, one A, inv fn(x A) A):
    forall u, v, w A:
        mul(mul(u, v), w) = mul(u, mul(v, w))
    forall u A:
        mul(one, u) = u
        mul(u, one) = u
        mul(inv(u), u) = one
        mul(u, inv(u)) = one
thm group_identity_unique:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, inv fn(x A) A, identity A:
        $GroupSetting(A, mul, one, inv)
        forall a A:
            mul(identity, a) = a
            mul(a, identity) = a
        =>:
            identity = one
    identity = mul(one, identity) = one
