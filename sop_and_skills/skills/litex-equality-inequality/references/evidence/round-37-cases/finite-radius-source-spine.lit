claim:
    ? forall delta1,delta2 R+:
        finite_set_min(union({delta1},{delta2})) $in R+
    union({delta1},{delta2}) $subset R+
    finite_set_min(union({delta1},{delta2})) $in union({delta1},{delta2})
    finite_set_min(union({delta1},{delta2})) $in R
    have radius R+=finite_set_min(union({delta1},{delta2}))
