have fn r35_ode_solution(x R) R = x^2 + 1

claim:
    ? forall x,x0 R,epsilon R+:
        x!=x0
        abs(x-x0)<epsilon
        =>:
            abs((r35_ode_solution(x)-r35_ode_solution(x0))/(x-x0)-2*x0)<epsilon
    x-x0!=0
    r35_ode_solution(x)=x^2+1
    r35_ode_solution(x0)=x0^2+1
    r35_ode_solution(x)-r35_ode_solution(x0)=(x^2+1)-(x0^2+1)=x^2-x0^2=(x-x0)*(x+x0)
    (r35_ode_solution(x)-r35_ode_solution(x0))/(x-x0)=((x-x0)*(x+x0))/(x-x0)=x+x0
    (r35_ode_solution(x)-r35_ode_solution(x0))/(x-x0)-2*x0=(x+x0)-2*x0=x-x0
    abs((r35_ode_solution(x)-r35_ode_solution(x0))/(x-x0)-2*x0)=abs(x-x0)<epsilon
