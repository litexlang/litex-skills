prop is_first_order_linear_recurrence_29(a, b, c, T fn(recurrence_index_29 N) R):
    forall n N+:
        a(n) * T(n) = b(n) * T(n - 1) + c(n)

prop is_summation_factor_29(a, b, s fn(factor_index_29 N) R):
    forall n N+:
        s(n) * b(n) = s(n - 1) * a(n - 1)

have fn scaled_recurrence_value_210(n N, s, a, T fn(scaled_index_210 N) R) R = s(n) * a(n) * T(n)

thm summation_factor_step_210:
    ? forall a, b, c, T, s fn(step_index_210 N) R, n N+:
        $is_first_order_linear_recurrence_29(a, b, c, T)
        $is_summation_factor_29(a, b, s)
        =>:
            scaled_recurrence_value_210(n, s, a, T) = scaled_recurrence_value_210(n - 1, s, a, T) + s(n) * c(n)
    claim:
        ? forall left_value, right_value, added_value R:
            left_value = right_value
            =>:
                left_value + added_value = right_value + added_value
    a(n) * T(n) = b(n) * T(n - 1) + c(n)
    s(n) * b(n) = s(n - 1) * a(n - 1)
    scaled_recurrence_value_210(n, s, a, T) = s(n) * a(n) * T(n)
    scaled_recurrence_value_210(n - 1, s, a, T) = s(n - 1) * a(n - 1) * T(n - 1)
    s(n) * a(n) * T(n) = s(n) * (a(n) * T(n))
    s(n) * (a(n) * T(n)) = s(n) * (b(n) * T(n - 1) + c(n))
    s(n) * (b(n) * T(n - 1) + c(n)) = s(n) * b(n) * T(n - 1) + s(n) * c(n)
    s(n) * b(n) * T(n - 1) = s(n - 1) * a(n - 1) * T(n - 1)
    s(n) * b(n) * T(n - 1) + s(n) * c(n) = s(n - 1) * a(n - 1) * T(n - 1) + s(n) * c(n)
    scaled_recurrence_value_210(n, s, a, T) = s(n) * b(n) * T(n - 1) + s(n) * c(n)
    scaled_recurrence_value_210(n - 1, s, a, T) + s(n) * c(n) = s(n - 1) * a(n - 1) * T(n - 1) + s(n) * c(n)
    scaled_recurrence_value_210(n, s, a, T) = scaled_recurrence_value_210(n - 1, s, a, T) + s(n) * c(n)

