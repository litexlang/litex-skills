thm scalar_product_congruence_probe22:
    ? forall lhs1,rhs1,lhs2,rhs2 R:
        lhs1=rhs1
        lhs2=rhs2
        =>:
            lhs1*lhs2=rhs1*rhs2

claim:
    ? forall c R,m Z:
        fn(k Z) R {c}(m)=c
        fn(k Z) R {c}(m+1)=c
        =>:
            fn(k Z) R {c}(m)*fn(k Z) R {c}(m+1)=c*c
    by thm scalar_product_congruence_probe22(fn(k Z) R {c}(m),c,fn(k Z) R {c}(m+1),c) => fn(k Z) R {c}(m)*fn(k Z) R {c}(m+1)=c*c
