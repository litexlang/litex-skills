claim:
    ? forall n N:
        n <= factorial(n)
    by induc k from 0:
        ? k <= factorial(k)
        ? from k = 0:
            k = 0 <= 1 = factorial(0) = factorial(k)
        ? induc:
            factorial(k) >= 1
            k+1 <= (k+1)*factorial(k) = factorial(k+1)
    n <= factorial(n)
