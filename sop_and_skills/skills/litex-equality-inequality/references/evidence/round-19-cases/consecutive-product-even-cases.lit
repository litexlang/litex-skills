claim:
    ? forall n Z:
        (n*(n+1))%2 = 0
    have q Z = quot(n,2)
    n = 2*q+n%2
    n%2 = 0 or n%2 = 1
    by cases:
        ? (n*(n+1))%2 = 0
        case n%2 = 0:
            n = 2*q
            n*(n+1) = 2*(q*(n+1))
            (n*(n+1))%2 = (2*(q*(n+1)))%2 = 0
        case n%2 = 1:
            n = 2*q+1
            n+1 = 2*(q+1)
            n*(n+1) = 2*(n*(q+1))
            (n*(n+1))%2 = (2*(n*(q+1)))%2 = 0
