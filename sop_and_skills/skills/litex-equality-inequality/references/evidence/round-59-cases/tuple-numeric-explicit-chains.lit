have fn r59_add2(u, v cart(R, R)) cart(R, R) = (u(1) + v(1), u(2) + v(2))
have fn r59_sub2(u, v cart(R, R)) cart(R, R) = (u(1) - v(1), u(2) - v(2))
have fn r59_smul2(k R, u cart(R, R)) cart(R, R) = (k * u(1), k * u(2))
have fn r59_dot2(u, v cart(R, R)) R = u(1) * v(1) + u(2) * v(2)
have fn r59_norm2_sq(u cart(R, R)) R = r59_dot2(u, u)

r59_add2((1,2),(3,4))=((1,2)(1)+(3,4)(1),(1,2)(2)+(3,4)(2))=(1+3,2+4)=(4,6)
r59_sub2((5,7),(2,3))=((5,7)(1)-(2,3)(1),(5,7)(2)-(2,3)(2))=(5-2,7-3)=(3,4)
r59_smul2(3,(2,-1))=(3*(2,-1)(1),3*(2,-1)(2))=(3*2,3*(-1))=(6,-3)
