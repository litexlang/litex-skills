have fn finite_integer_sum(first, last Z, term fn(term_index_21 Z) Z) Z by cases:
    case first <= last: sum(first, last, term)
    case first > last: 0

claim:
    ? forall a,b Z,f fn(k Z) Z:
        a <= b
        =>:
            finite_integer_sum(a,b,f) = finite_integer_sum(a-1,b-1,fn(k Z) Z {f(k+1)})
    a-1 <= b-1
    finite_integer_sum(a,b,f) = sum(a,b,f) = sum(a-1,b-1,fn(k Z) Z {f(k+1)}) = finite_integer_sum(a-1,b-1,fn(k Z) Z {f(k+1)})
