have fn finite_coefficient_product_211(first,last N,term fn(k N) R) R by cases:
    case first<=last: product(first,last,term)
    case first>last: 1

claim:
    ? forall f fn(k N) R,m N:
        finite_coefficient_product_211(m,m,fn(k N) R {f(k)})=f(m)
    finite_coefficient_product_211(m,m,fn(k N) R {f(k)})=product(m,m,fn(k N) R {f(k)})=fn(k N) R {f(k)}(m)=f(m)
