claim:
    ? forall n N:
        2^n >= n + 1
    by induc n from 0:
        ? 2^n >= n + 1
        ? from n = 0:
            2^n = 1 = n + 1
        ? induc:
            2^(n + 1) = 2^n * 2^1 = 2^n * 2
            2^n * 2 >= (n + 1) * 2
            (n + 1) * 2 = (n + 1) + (n + 1) >= (n + 1) + 1
            2^(n + 1) = 2^n * 2 >= (n + 1) * 2 >= (n + 1) + 1
