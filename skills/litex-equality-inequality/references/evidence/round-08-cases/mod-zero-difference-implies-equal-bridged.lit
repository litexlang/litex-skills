claim:
    ? forall a,b Z,m N+:
        (a-b)%m = 0
        =>:
            a%m = b%m
    a-b = m*quot(a-b,m)+(a-b)%m = m*quot(a-b,m)
    a = (a-b)+b = m*quot(a-b,m)+b = b+m*quot(a-b,m)
    (m*quot(a-b,m))%m = 0
    b%m+0 = b%m
    a%m = (b+m*quot(a-b,m))%m = (b%m+(m*quot(a-b,m))%m)%m = (b%m+0)%m = (b%m)%m = b%m
