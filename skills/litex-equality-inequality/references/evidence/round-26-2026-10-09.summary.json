    "source_anchor": {
      "source_path": "showcases/math_concepts_in_litex/9_topology/main.lit",
      "source_sha256": "b283936d6de2758690e0dc01d7a9f46ece5e931842eba7e6ce5467a52322f70d",
      "prefix": "template<A, B, CarrierC set, f fn(x A) B, g fn(y B) CarrierC>:\n    have fn composition(x A) CarrierC = g(f(x))\n\ntemplate<X, Y set, f fn(x X) Y, K power_set(X)>:\n    have fn restricted(x K) Y = f(x)\n",
      "composition_type": "thm composition_type:\n    ? forall A, B, CarrierC set, f fn(x A) B, g fn(y B) CarrierC:\n        \\composition<A,B,CarrierC,f,g> $in fn(x A) CarrierC\n    release thm fn_set_member(\\composition<A,B,CarrierC,f,g>, fn(x A) CarrierC)\n",
      "restriction_type": "thm restriction_type:\n    ? forall X, Y set, f fn(x X) Y, K power_set(X):\n        \\restricted<X,Y,f,K> $in fn(x K) Y\n    release thm fn_set_member(\\restricted<X,Y,f,K>, fn(x K) Y)\n",
      "restriction_value": "thm restriction_value:\n    ? forall X,Y set,f fn(x X)Y,K power_set(X),p K:\n        \\restricted<X,Y,f,K>(p) = f(p)\n    \\restricted<X,Y,f,K> $in fn(x K) Y\n    f(p) $in Y\n    \\restricted<X,Y,f,K>(p) $in Y\n    \\restricted<X,Y,f,K> = fn(x K) Y {f(x)}\n    \\restricted<X,Y,f,K>(p) = f(p)\n"
