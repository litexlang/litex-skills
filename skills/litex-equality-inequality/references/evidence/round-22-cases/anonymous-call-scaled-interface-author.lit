thm scalar_mul_congruence_probe22:
    ? forall lhs,rhs,factor R:
        lhs=rhs
        =>:
            lhs*factor=rhs*factor

claim:
    ? forall c,d R,m Z:
        fn(k Z) R {c}(m)=c
        =>:
            fn(k Z) R {c}(m)*d=c*d
    by thm scalar_mul_congruence_probe22(fn(k Z) R {c}(m),c,d) => fn(k Z) R {c}(m)*d=c*d
