claim:
    ? forall n N+,f fn(k Z) R:
        sum(1,n,fn(j Z) R {f(j+1)-f(j)}) = f(n+1)-f(1)
    let delta_terms = fn(j Z) R {f(j+1)-f(j)}
    by induc m from 1:
        ? sum(1,m,delta_terms) = f(m+1)-f(1)
        ? from m = 1:
            delta_terms(1) = f(1+1)-f(1)
            sum(1,m,delta_terms) = sum(1,1,delta_terms) = delta_terms(1) = f(1+1)-f(1) = f(m+1)-f(1)
        ? induc:
            m >= 1
            delta_terms(m+1) = f((m+1)+1)-f(m+1)
            sum(1,m+1,delta_terms) = sum(1,m,delta_terms)+delta_terms(m+1) = (f(m+1)-f(1))+(f((m+1)+1)-f(m+1)) = f((m+1)+1)-f(1)
    n >= 1
    sum(1,n,delta_terms) = f(n+1)-f(1)
    sum(1,n,fn(j Z) R {f(j+1)-f(j)}) = sum(1,n,delta_terms) = f(n+1)-f(1)
