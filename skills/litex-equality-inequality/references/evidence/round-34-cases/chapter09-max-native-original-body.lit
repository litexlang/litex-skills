thm r34_chapter09_max_native_original_body:
    ? forall a, b, A, B R, epsilon R+:
        abs(a - A) <= epsilon
        abs(b - B) <= epsilon
        =>:
            abs(max(a,b) - max(A,B)) <= epsilon
    a - A <= abs(a - A)
    a - A <= abs(a - A) <= epsilon
    a - A <= epsilon
    (a - A) + A <= epsilon + A
    (a - A) + A = a
    epsilon + A = A + epsilon
    a <= A + epsilon
    b - B <= abs(b - B)
    b - B <= abs(b - B) <= epsilon
    b - B <= epsilon
    (b - B) + B <= epsilon + B
    (b - B) + B = b
    epsilon + B = B + epsilon
    b <= B + epsilon
    A <= max(A,B)
    B <= max(A,B)
    A + epsilon <= max(A,B) + epsilon
    B + epsilon <= max(A,B) + epsilon
    a <= A + epsilon <= max(A,B) + epsilon
    a <= max(A,B) + epsilon
    b <= B + epsilon <= max(A,B) + epsilon
    b <= max(A,B) + epsilon
    max(a,b) <= max(A,B) + epsilon
    max(a,b) - max(A,B) <= (max(A,B) + epsilon) - max(A,B)
    (max(A,B) + epsilon) - max(A,B) = epsilon
    max(a,b) - max(A,B) <= epsilon
    A - a <= abs(A - a)
    abs(A - a) = abs(a - A)
    A - a <= abs(a - A)
    A - a <= abs(a - A) <= epsilon
    A - a <= epsilon
    (A - a) + a <= epsilon + a
    (A - a) + a = A
    epsilon + a = a + epsilon
    A <= a + epsilon
    B - b <= abs(B - b)
    abs(B - b) = abs(b - B)
    B - b <= abs(b - B)
    B - b <= abs(b - B) <= epsilon
    B - b <= epsilon
    (B - b) + b <= epsilon + b
    (B - b) + b = B
    epsilon + b = b + epsilon
    B <= b + epsilon
    a <= max(a,b)
    b <= max(a,b)
    a + epsilon <= max(a,b) + epsilon
    b + epsilon <= max(a,b) + epsilon
    A <= a + epsilon <= max(a,b) + epsilon
    A <= max(a,b) + epsilon
    B <= b + epsilon <= max(a,b) + epsilon
    B <= max(a,b) + epsilon
    max(A,B) <= max(a,b) + epsilon
    max(A,B) - max(a,b) <= (max(a,b) + epsilon) - max(a,b)
    (max(a,b) + epsilon) - max(a,b) = epsilon
    max(A,B) - max(a,b) <= epsilon
    -(max(a,b) - max(A,B)) = max(A,B) - max(a,b)
    -(max(a,b) - max(A,B)) <= epsilon
