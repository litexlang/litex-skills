claim:
    ? forall n N:
        n <= factorial(n)
    n >= 0
    n <= 0 or n > 0
    by cases:
        ? n <= factorial(n)
        case n <= 0:
            n = 0
            n = 0 <= 1 = factorial(0) = factorial(n)
        case n > 0:
            n $in N+
            factorial(n-1) >= 1
            n <= n*factorial(n-1) = factorial(n)
