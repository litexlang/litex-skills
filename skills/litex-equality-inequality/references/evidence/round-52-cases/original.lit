have fn r52_arithmetic_mean(x, y R) R = (x + y) / 2
have fn r52_geometric_mean(x, y R: x >= 0, y >= 0) R = sqrt(x * y)

claim:
    ? forall x, y R:
        x >= 0
        y >= 0
        =>:
            r52_geometric_mean(x, y) <= r52_arithmetic_mean(x, y)
    x * y >= 0
    sqrt(x * y)^2 = x * y
    (x + y)^2 - 4 * x * y = (x - y)^2
    0 <= (x - y)^2
    0 <= (x + y)^2 - 4 * x * y
    4 * x * y <= (x + y)^2
    x * y <= (x + y)^2 / 4
    ((x + y) / 2)^2 = (x + y)^2 / 4
    x * y <= ((x + y) / 2)^2
    0 <= sqrt(x * y)
    0 <= x + y
    0 < 2
    0 <= (x + y) / 2
    by contra:
        ? sqrt(x * y) <= (x + y) / 2
        sqrt(x * y) > (x + y) / 2
        sqrt(x * y)^2 > ((x + y) / 2)^2
        impossible x * y <= ((x + y) / 2)^2
    r52_geometric_mean(x, y) = sqrt(x * y)
    r52_arithmetic_mean(x, y) = (x + y) / 2
