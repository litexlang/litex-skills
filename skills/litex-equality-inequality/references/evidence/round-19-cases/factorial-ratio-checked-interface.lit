thm exact_quotient_integer:
    ? forall a Z,b N+:
        a%b = 0
        =>:
            a/b $in Z
    a = b*quot(a,b)+a%b = b*quot(a,b)
    a/b = quot(a,b)
claim:
    ? forall m,n N:
        m <= n
        =>:
            factorial(n)/factorial(m) $in Z
    factorial(n)%factorial(m) = 0
    release thm exact_quotient_integer(factorial(n),factorial(m))
